# Optional LLM. Without a key, recommendations use the grounded template mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Browser-intended MapGL key. Restrict products, Origin/Referer and quota in 2GIS.
# Without this key the consent-based map uses OpenStreetMap + Leaflet.
TWOGIS_MAPGL_KEY=

# Optional approved HTTPS feeds, obtained from providers or your licensed adapter.
# Server only. These tokens and URLs must never be sent to the browser.
# Without cinema/events feeds, public publisher adapters are used.
CINEMA_FEED_URL=
CINEMA_FEED_TOKEN=
EVENTS_FEED_URL=
EVENTS_FEED_TOKEN=
TRAFFIC_FEED_URL=
TRAFFIC_FEED_TOKEN=

# Telegram / Instagram credentials belong in a separate authorized collector.
# The collector publishes the normalized EVENTS_FEED_URL contract.
# Setup, schemas, source restrictions: docs/live-integrations.md

# Optional authorized photo feed. Same-day capture and display rights must be verified.
# No automatic Instagram scraping. Without this feed a credited archive photo is shown.
CITY_PHOTO_FEED_URL=
CITY_PHOTO_FEED_TOKEN=
# Comma-separated exact approved media CDN hostnames, no wildcards.
CITY_PHOTO_MEDIA_HOSTS=

# Browser-intended JavaScript API key. Restrict it to the exact Site domain in Yandex.
# Map/traffic/own markers only; never attach paid or geocoder products to this key.
YANDEX_MAPS_JS_API_KEY=
# Server geocoder preparation only. No public geocoder endpoint is connected yet.
# Keep false until eligibility, product/key settings and shared quota are checked.
YANDEX_GEOCODER_ENABLED=false
YANDEX_FREE_ELIGIBILITY_CONFIRMED=false
YANDEX_QUOTA_DEDICATED_BUDGET_CONFIRMED=false
# Server-only product key and WithTTL signing secret from the Yandex cabinet.
YANDEX_GEOCODER_API_KEY=
YANDEX_GEOCODER_SIGNING_SECRET=
# Separate random secret (at least 32 UTF-8 bytes) for pseudonymous quota identities.
YANDEX_QUOTA_HMAC_SECRET=
# A shared D1 DB binding and migration are also mandatory: docs/yandex-integration.md
